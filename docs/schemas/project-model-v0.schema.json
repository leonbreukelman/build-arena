{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.local/schemas/project-model-v0.schema.json",
  "title": "Project Model v0",
  "description": "Minimal shared project decomposition contract for build-arena, elenchus-core, and arena-calibration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "goal",
    "nonGoals",
    "components",
    "dependencies",
    "invariants",
    "observableChecks",
    "evidenceRequirements",
    "assumptions",
    "risks",
    "nearNeighborAlternatives",
    "heldOutProbes",
    "verificationGaps",
    "unclassifiedProjectSurface",
    "advisorySignalHandoff"
  ],
  "properties": {
    "schemaVersion": { "const": "project-model/v0" },
    "id": { "$ref": "#/$defs/identifier" },
    "source": { "$ref": "#/$defs/source" },
    "goal": { "$ref": "#/$defs/nonEmptyString" },
    "nonGoals": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
    "observableChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observableCheck" }
    },
    "evidenceRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRequirement" }
    },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "nearNeighborAlternatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/nearNeighborAlternative" }
    },
    "heldOutProbes": { "type": "array", "items": { "$ref": "#/$defs/heldOutProbe" } },
    "verificationGaps": { "type": "array", "items": { "$ref": "#/$defs/verificationGap" } },
    "unclassifiedProjectSurface": {
      "type": "array",
      "items": { "$ref": "#/$defs/unclassifiedProjectSurface" }
    },
    "advisorySignalHandoff": { "$ref": "#/$defs/advisorySignalHandoff" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_\\-]*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "riskLevel": { "enum": ["low", "medium", "high"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "primaryBacklogItem"],
      "properties": {
        "task": { "$ref": "#/$defs/nonEmptyString" },
        "primaryBacklogItem": { "$ref": "#/$defs/nonEmptyString" },
        "repo": { "$ref": "#/$defs/nonEmptyString" },
        "issue": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "riskLevel",
        "responsibilities",
        "ownedSurfaces",
        "observableCheckIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "kind": {
          "enum": [
            "source",
            "test",
            "documentation",
            "configuration",
            "spec",
            "process",
            "architecture",
            "strategy",
            "data",
            "integration",
            "operations",
            "fixture",
            "unknown"
          ]
        },
        "riskLevel": { "$ref": "#/$defs/riskLevel" },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "ownedSurfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "observableCheckIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromComponent", "toComponent", "kind", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "fromComponent": { "$ref": "#/$defs/identifier" },
        "toComponent": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["requires", "precedes", "blocks", "feeds", "informs"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "observableCheckIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "componentIds", "observableCheckIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "componentIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "observableCheckIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "observableCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "mode", "description", "observableSignal", "evidenceRequired"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "componentId": { "$ref": "#/$defs/identifier" },
        "mode": {
          "enum": [
            "test",
            "static-analysis",
            "simulation",
            "inspection",
            "artifact-audit",
            "stakeholder-decision",
            "non-code-rubric",
            "external-observation"
          ]
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "observableSignal": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRequired": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "noLiveApi": { "type": "boolean" }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "acceptedArtifactTypes", "requiredFor"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "acceptedArtifactTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "requiredFor": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["assumed", "confirmed", "disputed"] }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "componentId": { "$ref": "#/$defs/identifier" },
        "level": { "$ref": "#/$defs/riskLevel" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "mitigation": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "nearNeighborAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "whyNotPrimary", "distinguishingEvidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "whyNotPrimary": { "$ref": "#/$defs/nonEmptyString" },
        "distinguishingEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "heldOutProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "probeType", "scenario", "expectedBehavior", "evidenceRequired"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "componentId": { "$ref": "#/$defs/identifier" },
        "probeType": { "enum": ["held-out-example", "counterexample", "perturbation", "tabletop", "negative-control"] },
        "scenario": { "$ref": "#/$defs/nonEmptyString" },
        "expectedBehavior": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRequired": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "verificationGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description", "affectedComponentIds", "proposedClosureCheck"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "severity": { "$ref": "#/$defs/riskLevel" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "affectedComponentIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "proposedClosureCheck": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "unclassifiedProjectSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "reasonUnclassified", "candidateOwners"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "reasonUnclassified": { "$ref": "#/$defs/nonEmptyString" },
        "candidateOwners": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "advisorySignalHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "expectedFields", "optionalFLabelHint"],
      "properties": {
        "consumer": { "const": "elenchus-core" },
        "expectedFields": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "optionalFLabelHint": { "type": "boolean" }
      }
    }
  }
}
