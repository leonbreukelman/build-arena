{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-arena.local/schemas/proposer-handoff-v0.schema.json",
  "title": "Proposer Handoff v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceScorecardId",
    "snapshotId",
    "freshnessStatus",
    "selectedFindingId",
    "hypothesisIntent",
    "targetFiles",
    "successCriteria",
    "failureCriteria",
    "verificationCommands",
    "rollbackCondition",
    "prohibitedPaths",
    "requiresOwnerApproval",
    "evidenceRefs",
    "advisoryNotes",
    "notAuthorizedForMutation"
  ],
  "properties": {
    "schemaVersion": {"const": "proposer-handoff/v0"},
    "id": {"type": "string"},
    "sourceScorecardId": {"type": "string"},
    "snapshotId": {"type": "string"},
    "freshnessStatus": {"enum": ["fresh", "dirty-worktree", "base-advanced", "branch-diverged", "snapshot-mismatch", "unknown"]},
    "selectedFindingId": {"type": "string"},
    "hypothesisIntent": {"type": "string"},
    "targetFiles": {"type": "array", "items": {"type": "string"}},
    "successCriteria": {"type": "array", "items": {"type": "string"}},
    "failureCriteria": {"type": "array", "items": {"type": "string"}},
    "verificationCommands": {"type": "array", "items": {"type": "string"}},
    "rollbackCondition": {"type": "string"},
    "prohibitedPaths": {"type": "array", "items": {"type": "string"}},
    "requiresOwnerApproval": {"type": "boolean"},
    "evidenceRefs": {"type": "array", "items": {"type": "object"}},
    "advisoryNotes": {"type": "array", "items": {"type": "string"}},
    "notAuthorizedForMutation": {"const": true}
  }
}
