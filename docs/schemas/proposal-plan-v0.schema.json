{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-arena.local/schemas/proposal-plan-v0.schema.json",
  "title": "Proposal Plan v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceScorecardId",
    "snapshotId",
    "projectRoot",
    "repoFactsHash",
    "baseLineage",
    "candidateCount",
    "omittedCount",
    "skippedCount",
    "skippedFindings",
    "findingDispositions",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {"const": "proposal-plan/v0"},
    "id": {"type": "string"},
    "sourceScorecardId": {"type": "string"},
    "snapshotId": {"type": "string"},
    "projectRoot": {"type": "string"},
    "repoFactsHash": {"type": "string"},
    "baseLineage": {"type": "object"},
    "candidateCount": {"type": "integer", "minimum": 0},
    "omittedCount": {"type": "integer", "minimum": 0},
    "skippedCount": {"type": "integer", "minimum": 0},
    "skippedFindings": {"type": "array", "items": {"$ref": "#/$defs/skippedFinding"}},
    "findingDispositions": {"type": "array", "items": {"$ref": "#/$defs/findingDisposition"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "findingDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "rank", "title", "disposition", "domain", "target_path", "evidence_paths"],
      "properties": {
        "finding_id": {"type": "string"},
        "rank": {"type": "integer"},
        "title": {"type": "string"},
        "disposition": {
          "enum": [
            "consumed_as_context",
            "docs_candidate",
            "code_candidate",
            "fitness_function_candidate",
            "advisory_backlogged",
            "no_single_file_target"
          ]
        },
        "domain": {"type": "string"},
        "target_path": {"type": "string"},
        "evidence_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "skippedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "rank", "title", "reason", "evidence_paths"],
      "properties": {
        "finding_id": {"type": "string"},
        "rank": {"type": "integer"},
        "title": {"type": "string"},
        "reason": {"type": "string"},
        "evidence_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "finding_id",
        "title",
        "target_path",
        "intent",
        "success_criterion",
        "repo_facts_hash",
        "repo_facts_block",
        "grounding_constraints",
        "verification_commands",
        "priority_score",
        "evidence_refs",
        "source_recommended_action",
        "target_paths",
        "base_lineage",
        "intent_hash",
        "proposal_key",
        "registry_status"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "finding_id": {"type": "string"},
        "title": {"type": "string"},
        "target_path": {"type": "string"},
        "intent": {"type": "string"},
        "success_criterion": {"type": "string"},
        "repo_facts_hash": {"type": "string"},
        "repo_facts_block": {"type": "string"},
        "grounding_constraints": {"type": "array", "items": {"type": "string"}},
        "verification_commands": {"type": "array", "items": {"type": "string"}},
        "priority_score": {"type": "number"},
        "evidence_refs": {"type": "array", "items": {"type": "object"}},
        "source_recommended_action": {"type": "string"},
        "target_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "base_lineage": {"type": "object"},
        "intent_hash": {"type": "string"},
        "proposal_key": {"type": "string"},
        "registry_status": {"type": "string"}
      }
    }
  }
}
